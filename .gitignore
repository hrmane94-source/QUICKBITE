# ==============================================================================
# QuickBite — Workspace .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js

# Expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# Build Outputs
dist/
build/
out/
bin/
obj/
*.apk
*.aab
*.ipa
*.app
*.dSYM/
*.bundle

# React Native / Android / iOS (Expo Continuous Native Generation - CNG)
.gradle/
.kotlin/
.cxx/
local.properties
*.keystore
android/
ios/
apps/student-app/android/
apps/student-app/ios/
apps/*/android/
apps/*/ios/
android/app/build/
ios/Pods/
ios/build/

# Supabase
.supabase/

# Environment Variables & Secrets
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
# Exception: keep example environment file tracked
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
*.lcov
.nyc_output/

# IDE & Editor Temporary Files
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# TypeScript & Cache
*.tsbuildinfo
.turbo/
.cache/
.eslintcache
.stylelintcache
